  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Signal Blue action in the working world; deep step on hover, slight press scale.",
      "html": "<button class=\"ds-btn-primary\">Analyse</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border-radius:10px;border:1px solid transparent;background:#2a78d6;color:#fff;font-family:Geist,system-ui,sans-serif;font-weight:500;font-size:0.9rem;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,0.15),0 1px 2px rgba(16,24,40,0.06);transition:background 160ms cubic-bezier(0.2,0.7,0.2,1),transform 110ms cubic-bezier(0.2,0.7,0.2,1)}.ds-btn-primary:hover{background:#1c5cab}.ds-btn-primary:active{transform:translateY(1px) scale(0.985)}.ds-btn-primary:focus-visible{outline:2px solid #2a78d6;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface button with a line-strong hairline for secondary actions.",
      "html": "<button class=\"ds-btn-secondary\">Compare</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border-radius:10px;border:1px solid #cfd4dc;background:#fff;color:#0f1419;font-family:Geist,system-ui,sans-serif;font-weight:500;font-size:0.9rem;cursor:pointer;transition:background 160ms cubic-bezier(0.2,0.7,0.2,1),transform 110ms cubic-bezier(0.2,0.7,0.2,1)}.ds-btn-secondary:hover{background:#f2f4f7}.ds-btn-secondary:active{transform:translateY(1px) scale(0.985)}.ds-btn-secondary:focus-visible{outline:2px solid #2a78d6;outline-offset:2px}"
    },
    {
      "name": "Story Search",
      "kind": "input",
      "refersTo": "search-hero",
      "description": "The story hero's 64px search field: mono input, navy go button, accent halo on focus.",
      "html": "<form class=\"ds-hero-search\"><input aria-label=\"NSE ticker\" placeholder=\"Search an NSE ticker\"><button type=\"button\" class=\"ds-hero-go\">Analyse <svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32z\"/></svg></button></form>",
      "css": ".ds-hero-search{display:flex;align-items:center;gap:12px;height:64px;max-width:560px;padding:0 8px 0 20px;border-radius:16px;background:#fff;border:1px solid rgba(11,27,51,0.12);box-shadow:0 1px 2px rgba(11,27,51,0.06),0 24px 48px -24px rgba(11,27,51,0.30);transition:border-color 180ms cubic-bezier(0.16,1,0.3,1),box-shadow 180ms cubic-bezier(0.16,1,0.3,1)}.ds-hero-search:focus-within{border-color:#2a78d6;box-shadow:0 0 0 5px rgba(42,120,214,0.16),0 24px 48px -24px rgba(11,27,51,0.30)}.ds-hero-search input{flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;font-family:'Geist Mono',ui-monospace,monospace;font-size:1.08rem;color:#0b1b33}.ds-hero-search input::placeholder{font-family:Geist,system-ui,sans-serif;color:#7a879c}.ds-hero-go{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border-radius:12px;border:0;background:#0b1b33;color:#fff;font-family:Geist,system-ui,sans-serif;font-weight:600;cursor:pointer;transition:background 160ms cubic-bezier(0.16,1,0.3,1),transform 120ms cubic-bezier(0.16,1,0.3,1)}.ds-hero-go:hover{background:#1c5cab}.ds-hero-go svg{transition:transform 160ms cubic-bezier(0.16,1,0.3,1)}.ds-hero-go:hover svg{transform:translateX(3px)}.ds-hero-go:active{transform:scale(0.97)}.ds-hero-go:focus-visible{outline:2px solid #2a78d6;outline-offset:3px}"
    },
    {
      "name": "Showcase Pick Chip",
      "kind": "chip",
      "refersTo": "pick-chip",
      "description": "Story pill launching a showcase report: mono ticker plus short description; lifts on hover.",
      "html": "<a href=\"#\" class=\"ds-pick-chip\"><span class=\"ds-sym\">TCS</span><span class=\"ds-desc\">IT services</span></a>",
      "css": ".ds-pick-chip{display:inline-flex;align-items:baseline;gap:8px;padding:8px 14px;border-radius:999px;text-decoration:none;background:rgba(255,255,255,0.78);border:1px solid rgba(11,27,51,0.10);transition:border-color 160ms cubic-bezier(0.16,1,0.3,1),background 160ms cubic-bezier(0.16,1,0.3,1),transform 160ms cubic-bezier(0.16,1,0.3,1),box-shadow 160ms cubic-bezier(0.16,1,0.3,1)}.ds-pick-chip:hover,.ds-pick-chip:focus-visible{border-color:#2a78d6;background:#fff;transform:translateY(-2px);box-shadow:0 10px 24px -14px rgba(11,27,51,0.4);outline:none}.ds-sym{font-family:'Geist Mono',ui-monospace,monospace;font-weight:600;font-size:0.86rem;color:#0b1b33}.ds-desc{font-family:Geist,system-ui,sans-serif;font-size:0.8rem;color:#56647c}"
    },
    {
      "name": "Working Card with Figure",
      "kind": "card",
      "refersTo": "card",
      "description": "16px panel on the Dim surface with a clickable mono figure and its trace call to action.",
      "html": "<div class=\"ds-card\"><div class=\"ds-kpi-label\">Fair value (base)</div><div class=\"ds-kpi-value\">&#8377;3,812</div><button class=\"ds-kpi-cta\">How it was built</button></div>",
      "css": ".ds-card{background:#242a34;color:#eef1f6;border:1px solid #333b47;border-radius:16px;padding:20px 22px;box-shadow:0 1px 2px rgba(0,0,0,0.25);display:grid;gap:6px;font-family:Geist,system-ui,sans-serif;max-width:280px}.ds-kpi-label{font-size:0.78rem;color:#939cab}.ds-kpi-value{font-family:'Geist Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;font-size:1.55rem;font-weight:500;letter-spacing:-0.02em;line-height:1.1}.ds-kpi-cta{justify-self:start;border:0;background:none;padding:4px 0 0;font:inherit;font-size:0.74rem;color:#6aa6ee;opacity:0.75;cursor:pointer;transition:opacity 160ms cubic-bezier(0.2,0.7,0.2,1),transform 160ms cubic-bezier(0.2,0.7,0.2,1)}.ds-kpi-cta:hover,.ds-kpi-cta:focus-visible{opacity:1;transform:translateX(2px);outline:none}"
    },
    {
      "name": "Stance Badge",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Status pill: tinted fill, status ink, icon plus label, never colour alone.",
      "html": "<span class=\"ds-stance\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M229.66 77.66l-128 128a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L96 188.69 218.34 66.34a8 8 0 0 1 11.32 11.32z\"/></svg>Fairly valued</span>",
      "css": ".ds-stance{display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px 0 9px;border-radius:999px;font-family:Geist,system-ui,sans-serif;font-weight:600;font-size:0.92rem;background:rgba(70,210,122,0.14);color:#46d27a}"
    },
    {
      "name": "Tabs with Sliding Ink",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Working tabs on Dim: ink-3 to ink on select, one 2px accent line under the active tab.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Overview</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Valuation <span class=\"ds-count\">5</span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">News</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;border-bottom:1px solid #333b47;background:#1c2028;font-family:Geist,system-ui,sans-serif}.ds-tab{position:relative;display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 14px;border:0;background:none;color:#939cab;font:inherit;font-weight:500;cursor:pointer;transition:color 160ms cubic-bezier(0.2,0.7,0.2,1)}.ds-tab:hover{color:#eef1f6}.ds-tab[aria-selected=\"true\"]{color:#eef1f6}.ds-tab[aria-selected=\"true\"]::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;border-radius:2px;background:#3987e5}.ds-tab:focus-visible{outline:2px solid #3987e5;outline-offset:2px;border-radius:6px}.ds-count{font-family:'Geist Mono',ui-monospace,monospace;font-size:0.72rem;padding:0 6px;border-radius:999px;background:#2b323d;color:#b7bfcc}"
    },
    {
      "name": "Product Window",
      "kind": "custom",
      "refersTo": "product-window",
